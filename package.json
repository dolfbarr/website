{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "20.x"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "check:node": "node -e \"if (!process.versions.node.startsWith('20.')) { console.error('Node 20.x is required. Current: ' + process.versions.node); process.exit(1) }\"",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "test:unit": "vitest",
    "test:coverage": "vitest run --coverage",
    "test": "pnpm run test:unit run && pnpm run test:e2e",
    "cypress:install": "cypress install",
    "pretest:e2e": "pnpm run cypress:install",
    "test:e2e": "cypress run --browser chrome",
    "ci": "pnpm run check:node && pnpm run typecheck && pnpm run lint && start-server-and-test dev http://localhost:4321 test",
    "lint": "pnpm run lint:eslint && pnpm run lint:stylelint",
    "lint:eslint": "eslint --ext .js,.ts,.jsx,.tsx,.astro src",
    "lint:stylelint": "stylelint \"src/**/*.{astro,scss}\"",
    "typecheck": "astro sync && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "3.1.6",
    "@fontsource/play": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-feather": "^2.0.10",
    "remark-shiki-twoslash": "^3.1.3",
    "tailwindcss": "^3.4.19"
  },
  "repository": {
    "url": "https://github.com/dolfbarr/website"
  },
  "devDependencies": {
    "@astrojs/react": "^3.6.3",
    "@astrojs/tailwind": "^5.1.5",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "0.34.6",
    "astro": "^3.6.5",
    "astro-eslint-parser": "^1.4.0",
    "cypress": "^13.17.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-config-standard-with-typescript": "^39.1.1",
    "eslint-plugin-astro": "^0.29.1",
    "eslint-plugin-html": "^7.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-react": "^7.37.5",
    "happy-dom": "^20.11.12",
    "lefthook": "^1.13.6",
    "postcss": "^8.5.26",
    "postcss-html": "^1.8.1",
    "postcss-import": "^15.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.12.3",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "sass": "^1.103.1",
    "start-server-and-test": "^2.1.5",
    "stylelint": "^15.11.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recommended-scss": "^13.1.0",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-prettier": "^4.1.0",
    "typescript": "^5.3.3",
    "vitest": "^0.34.6"
  }
}
