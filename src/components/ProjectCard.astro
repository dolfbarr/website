---
import Card from '@components/Card.astro'
import { type Project } from '@utils/types'
import { GitHub, Star } from 'react-feather'

import Iconed from './Iconed.astro'
import Link from './Link.astro'
import Stack from './Stack.astro'

export type Props = {
  project: Project
}

const { project } = Astro.props
---

<Card>
  <div slot="title" class="flex items-center justify-between">
    <span class="flex">
      {
        project?.url ? (
          <Link
            isExternal
            analyticsClick={`project-${project.title}`}
            analyticsTitle={project.title}
            class="whitespace-nowrap"
            title={project.title}
            href={project.url}>
            {project.title}
          </Link>
        ) : (
          <span>{project.title}</span>
        )
      }
      {
        project.stars && (
          <Iconed class="relative top-2 ml-1 text-base">
            <Star slot="icon" />
            {project.stars}+
          </Iconed>
        )
      }
    </span>
    <Link
      isExternal
      class="flex flex-col justify-center"
      analyticsClick={`project-${project.title}-github`}
      analyticsTitle={project.title + '-github'}
      title={project.title + '-github'}
      href={project.github}>
      <GitHub />
      <span class="sr-only">GitHub repository for {project.title}</span>
    </Link>
  </div>

  <span class="py-2">{project.description}</span>

  <Stack stack={project.stack ?? []} />
</Card>
