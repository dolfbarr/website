---
import { CONTACTS } from '@utils/data'
import { ExternalLink, Moon, Sun } from 'react-feather'

import Button from './Button.astro'
import Iconed from './Iconed.astro'
import NavLink from './NavLink.astro'
import Section from './Section.astro'

export type Props = {
  class?: string
}

const { class: className, ...attrs } = Astro.props
---

<header class:list={['mt-8 w-full font-play text-xl', className]} {...attrs}>
  <Section class="flex items-center justify-between gap-4 pb-2">
    <nav class="flex items-center">
      <ul class="flex items-center gap-4 sm:gap-6">
        <li>
          <NavLink
            title="About"
            href="/"
            analyticsClick="about-page"
            analyticsTitle="About page">
            About
          </NavLink>
        </li>
        <li>
          <NavLink
            title="Notes"
            href="/notes/"
            analyticsClick="notes-page"
            analyticsTitle="Notes page">
            Notes
          </NavLink>
        </li>
        <li>
          <NavLink
            href={CONTACTS.resume.url}
            title={CONTACTS.resume.title}
            analyticsClick="resume-download"
            isExternal>
            <Iconed>
              <ExternalLink slot="icon" />
              <span>Resume</span>
            </Iconed>
          </NavLink>
        </li>
      </ul>
    </nav>
    <Button
      title="Switch theme"
      analyticsClick="switch-theme"
      analyticsTitle="Switch theme"
      data-theme-button
      class="relative flex h-8 w-8 items-center justify-center rounded px-0 py-0 text-center leading-none transition-colors">
      <Sun
        size={16}
        className="absolute rotate-0 scale-100 opacity-100 transition-all duration-500 ease-in-out dark:-rotate-90 dark:scale-0 dark:opacity-0"
      />
      <Moon
        size={16}
        className="absolute rotate-90 scale-0 opacity-0 transition-all duration-500 ease-in-out dark:rotate-0 dark:scale-100 dark:opacity-100"
      />
      <span class="sr-only">Switch theme</span>
    </Button>
  </Section>
</header>

<script>
  const themeButton = document.querySelector(
    '[data-theme-button]',
  ) as HTMLButtonElement | null

  if (themeButton) {
    themeButton.addEventListener('click', () => {
      const wasDarkMode = document.documentElement.classList.contains('dark')

      document.documentElement.classList.toggle('dark', !wasDarkMode)
      document.documentElement.style.colorScheme = wasDarkMode
        ? 'light'
        : 'dark'

      localStorage.setItem('theme', wasDarkMode ? 'light' : 'dark')
    })
  }
</script>
