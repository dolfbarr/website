---
import { SEPARATOR } from '@utils/data'
export type Props = {
  class?: string
  skills: string[]
}

const { class: className, skills } = Astro.props
---

<p
  class:list={[
    'flex flex-wrap justify-start gap-1 font-light leading-tight text-gray-500 dark:text-stone-400',
    className ?? '',
  ]}>
  <slot name="prepend" />
  {
    skills.map((skill, index) => (
      <span key={skill} data-testid="skill" class="rounded-full py-0">
        {skill}
        {index !== skills.length - 1 && (
          <span class="inline-flex pl-1">{SEPARATOR}</span>
        )}
      </span>
    ))
  }
  <slot name="append" />
</p>
