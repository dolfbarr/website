---
import { Hash } from 'react-feather'

import Link from './Link.astro'
export type Props = {
  headingLevel?: number
  href?: string
  class?: string
  id: string
  iconSize?: number
  title: string
}

type HeadingElement = 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'div'

const {
  id,
  class: className,
  headingLevel = 2,
  href = null,
  iconSize = 24,
  title,
  ...attrs
} = Astro.props

const TitleElement = (
  headingLevel >= 1 && headingLevel <= 6 ? 'h' + headingLevel : 'div'
) as HeadingElement
---

<TitleElement
  class:list={['flex items-baseline justify-between', className ?? '']}
  id={id}
  data-testid={id}
  {...attrs}>
  <Link
    analyticsClick={id + '-event'}
    class:list={['group inline-flex', !href && 'md:-ml-8']}
    title={title}
    href={href ?? `#${id}`}>
    {
      !href && (
        <span class="instapaper_ignore not-sr-only hidden flex-col items-center justify-center opacity-0 transition group-hover:opacity-100 md:inline-flex md:w-8">
          <Hash strokeWidth={3} size={iconSize} />
        </span>
      )
    }
    <span>
      <slot />
    </span>
  </Link>
  {
    Astro.slots.has('aside') && (
      <span class="flex flex-col items-center justify-center">
        <slot name="aside" />
      </span>
    )
  }
</TitleElement>
