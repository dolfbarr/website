---
import { CONFIG } from 'config'

import Link from './Link.astro'

export type Props = {
  class?: string
  title: string
  href: string
  isExternal?: boolean
  analyticsClick: string
  analyticsTitle?: string
}
const {
  class: className,
  title,
  href,
  isExternal,
  analyticsClick,
  analyticsTitle,
  ...attrs
} = Astro.props
const pathname = new URL(Astro.request.url).pathname
const currentPath = pathname.replace(`${CONFIG.base}`, '').slice(1)
const isActive =
  href === '/'
    ? currentPath === '' || currentPath === '/'
    : currentPath === href.slice(1) || currentPath.startsWith(href.slice(1))
---

<>
  {
    isActive ? (
      <span
        aria-current="page"
        class:list={['border-b-2', className ?? '']}
        {...attrs}>
        <slot />
      </span>
    ) : (
      <Link
        analyticsClick={analyticsClick}
        analyticsTitle={analyticsTitle ?? title}
        href={href}
        title={title}
        class:list={[className ?? '']}
        isExternal={isExternal ?? false}>
        <slot />
      </Link>
    )
  }
</>
