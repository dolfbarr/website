---
import Button from '@components/Button.astro'
import Heading from '@components/Heading.astro'
import Iconed from '@components/Iconed.astro'
import Link from '@components/Link.astro'
import ProjectCard from '@components/ProjectCard.astro'
import Section from '@components/Section.astro'
import SkillsList from '@components/SkillsList.astro'
import StartOfContentAnchor from '@components/StartOfContentAnchor.astro'
import Workplace from '@components/Workplace.astro'
import WorkplaceCard from '@components/WorkplaceCard.astro'
import Main from '@layouts/Main.astro'
import {
  CONTACTS,
  LOCATION,
  META,
  PERSONAL_DATA,
  PROJECTS,
  SEPARATOR,
  URLS,
  WORK,
} from '@utils/data'
import { MapPin, Clock as ClockIcon, Mail, Download } from 'react-feather'

const allSkills = [
  ...new Set([
    ...WORK.experience
      .filter((workplace) => workplace.skills)
      .map((workplace) => workplace.skills)
      .flat(),
  ]),
] as string[]

const title = 'About'
---

<Main fullTitle={title + META.ogTitle} title={title}>
  <Section class="relative mb-9">
    <div class="mb-9 flex flex-wrap items-center">
      <StartOfContentAnchor />
      <Heading
        headingLevel={1}
        id="greeting"
        iconSize={32}
        title="Main Section Anchor">
        <>
          Hi!
          <br class="sm:hidden" />
          I&rsquo;m
          {PERSONAL_DATA.fullName}
        </>
        <div
          class="absolute right-0 top-5 flex items-baseline justify-between gap-4"
          slot="aside">
          <Link
            href={`mailto:${CONTACTS.email.url}`}
            title={CONTACTS.email.title + ': ' + URLS.email}
            isExternal
            analyticsClick="email-top"
            analyticsTitle={CONTACTS.email.title}
            class="hidden md:inline-block">
            <Mail />
          </Link>
        </div>
      </Heading>
      <span
        role="img"
        aria-label="waving hand"
        class="ml-4 hidden origin-bottom-right text-6xl transition-all duration-[2000ms] ease-in-out hover:animate-wave sm:inline-flex">
        👋
      </span>
    </div>
    <p class="text-xl leading-loose">
      a
      <em>{PERSONAL_DATA.occupation}</em>{
        WORK.experience[0] && !WORK.experience[0].endDate && (
          <span>
            {' '}
            at
            <Link
              href={WORK.experience[0].url}
              title={WORK.experience[0].company}
              analyticsClick={`current-workplace-${WORK.experience[0].company}`}
              analyticsTitle={'Current: ' + WORK.experience[0].company}
              isExternal>
              <Workplace companyName={WORK.experience[0].company} />
            </Link>
          </span>
        )
      }
      with {WORK.totalYearsOfExperience}+&nbsp;YoE based in
      <span class="inline-flex items-center gap-1.5 align-middle">
        <Button
          aria-expanded="false"
          aria-controls="map-container"
          analyticsClick="open-map"
          analyticsTitle="Open map"
          class="group/location inline-flex h-6 items-center px-1.5 py-0 text-sm leading-none sm:h-[1.65rem] sm:text-base"
          data-map-button
          title={LOCATION.flag + ' ' + LOCATION.title}>
          <Iconed class="inline-flex items-center">
            <MapPin slot="icon" size={14} data-map-button-icon />
            <span class="inline-grid grid-cols-1 grid-rows-1 text-left">
              <span
                class="col-start-1 row-start-1 inline-flex tracking-[.008em] opacity-100 transition-opacity duration-200 group-hover/location:opacity-0 [.safari_&]:tracking-[.01725em]">
                {LOCATION.title}
              </span>
              <span
                class="col-start-1 row-start-1 inline-flex opacity-0 transition-opacity duration-200 group-hover/location:opacity-100">
                {LOCATION.original}
              </span>
            </span>
          </Iconed>
        </Button>
        <span
          aria-hidden="true"
          class="dimmed text-base leading-none sm:text-lg">
          {SEPARATOR}
        </span>
        <span
          class="dimmed inline-flex items-center gap-1 font-mono text-base tabular-nums leading-none sm:text-lg">
          <ClockIcon
            strokeWidth={2.5}
            size={18}
            class="inline-block shrink-0"
          />
          <time
            title={LOCATION.timeZoneText}
            class="inline-block min-w-[3.25rem]"
            data-clock
            data-time-zone={LOCATION.timeZone}
            dateTime="">
            --:--
          </time>
        </span>
      </span>. I&rsquo;m
      <em>passionate about web</em>
      and, especially, frontend development. I like to be on the edge of
      <em>solving business problems</em>
      & appeal for users and believe that
      <em>soft skills</em>
      and
      <em>clean code</em>
      matter.
    </p>

    <p
      class="mt-6 flex flex-wrap justify-center gap-x-8 gap-y-2 overflow-hidden text-center text-xl leading-loose">
      {
        PERSONAL_DATA.tagLines.map((tagLine) => (
          <span key={tagLine} data-testid="tagLine" class="tag relative">
            {tagLine}
          </span>
        ))
      }
    </p>
  </Section>

  <div
    id="map-container"
    class="h-0 overflow-hidden rounded-lg transition-[height,box-shadow,opacity] duration-300 ease-in-out"
    data-map-container
    data-map-src={LOCATION.link}>
  </div>

  <Section data-testid="projects" class="mb-9">
    <Heading id="projects" title="Projects" class="mb-1">Projects</Heading>
    <p class="dimmed mb-5">
      I&rsquo;m currently involved in a few small open-source projects. Keep an
      eye out for more contributions from me soon 🚀
    </p>
    <ul class="grid grid-cols-1 gap-x-5 gap-y-4 sm:grid-cols-2 sm:gap-y-8">
      {
        PROJECTS.map((project) => (
          <ProjectCard key={project.title} project={project} />
        ))
      }
    </ul>
  </Section>

  <Section data-testid="experience" class="mb-9">
    <Heading id="experience" title="Experience" class="mb-5">
      Work Experience {SEPARATOR}{' '}
      {WORK.totalYearsOfExperience}+ years
      <div class="flex gap-1" slot="aside">
        <Link
          isExternal
          href={CONTACTS.resume.url}
          title={CONTACTS.resume.title}
          analyticsClick="resume-download"
          class="hidden md:inline-block">
          <Download />
          <span class="sr-only">{CONTACTS.resume.title}</span>
        </Link>
      </div>
    </Heading>
    <ul class="grid grid-cols-1 gap-x-5 gap-y-4 sm:grid-cols-2 sm:gap-y-8">
      {
        WORK.experience.map((workplace) => (
          <WorkplaceCard
            key={`${workplace.company}-${workplace.startDate}`}
            workplace={workplace}
          />
        ))
      }
    </ul>
  </Section>

  <Section data-testid="skills-section" class="mb-9 text-current">
    <Heading id="skills" title="Skills" class="mb-5">Skills</Heading>
    <SkillsList skills={allSkills} />
  </Section>
</Main>

<script>
  import { formatTime } from '@utils/clock'

  const mapButton = document.querySelector(
    '[data-map-button]',
  ) as HTMLButtonElement | null

  const mapContainer = document.querySelector(
    '[data-map-container]',
  ) as HTMLDivElement | null
  const mapButtonIcon = document.querySelector('[data-map-button-icon]')
  const clock = document.querySelector('[data-clock]') as HTMLTimeElement | null

  const updateClock = (clockElement: HTMLTimeElement) => {
    const timeZone = clockElement.dataset.timeZone

    if (!timeZone) {
      return
    }

    const time = formatTime(new Date(), timeZone)

    clockElement.dateTime = time
    clockElement.textContent = time
  }

  const ensureMapFrame = () => {
    const mapSource = mapContainer?.dataset.mapSrc

    if (!mapContainer || mapContainer.querySelector('iframe') || !mapSource) {
      return
    }

    const mapFrame = document.createElement('iframe')
    mapFrame.title = 'Location map'
    mapFrame.className = 'h-96 w-full'
    mapFrame.src = mapSource
    mapFrame.allowFullscreen = true
    mapFrame.loading = 'lazy'
    mapFrame.referrerPolicy = 'no-referrer-when-downgrade'
    mapFrame.setAttribute(
      'sandbox',
      'allow-scripts allow-same-origin allow-popups',
    )

    mapContainer.append(mapFrame)
  }

  const mapToggle = () => {
    if (!mapContainer) {
      return
    }

    const wasOpen = mapContainer.classList.contains('h-96')

    if (!wasOpen) {
      ensureMapFrame()
    }

    const removeOrAdd = wasOpen ? 'remove' : 'add'
    const addOrRemove = wasOpen ? 'add' : 'remove'

    mapButton?.setAttribute('aria-expanded', String(!wasOpen))
    mapButton?.classList[removeOrAdd](
      'shadow-inner',
      'bg-gray-50',
      'dark:bg-stone-800',
    )
    mapButtonIcon?.classList[removeOrAdd]('rotate-180')

    mapContainer.classList[removeOrAdd](
      'h-96',
      'mb-8',
      'border',
      'border-gray-200',
      'dark:border-stone-800',
      'shadow-xl',
      'shadow-gray-300/70',
      'dark:shadow-2xl',
      'dark:shadow-black/80',
    )
    mapContainer.classList[addOrRemove]('h-0', 'mb-0')
  }

  if (clock) {
    updateClock(clock)
    window.setInterval(() => {
      updateClock(clock)
    }, 15_000)
  }

  mapButton?.addEventListener('click', mapToggle)
</script>

<style>
  .tag::after {
    content: '⋅';
    display: block;
    position: absolute;
    top: 0;
    right: -0.5em;
    width: 0;
  }

  .tag:last-of-type:after {
    display: none;
  }

  @media (max-width: 410px) {
    .tag:after {
      display: none;
    }
  }

  @media (min-width: 410px) and (max-width: 418px) {
    .tag:nth-child(1):after {
      display: none;
    }
  }

  @media (min-width: 419px) and (max-width: 624px) {
    .tag:nth-child(2n):after {
      display: none;
    }
  }

  @media (min-width: 640px) and (max-width: 672px) {
    .tag:nth-child(2n):after {
      display: none;
    }
  }
</style>
