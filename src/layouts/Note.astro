---
import Iconed from '@components/Iconed.astro'
import Link from '@components/Link.astro'
import Separator from '@components/Separator.astro'
import { META, SEPARATOR, URLS } from '@utils/data'
import { getReadingTime } from '@utils/readingTime'
import { Social, type Note as NoteType } from '@utils/types'
import { Image } from 'astro:assets'
import { ArrowLeft } from 'react-feather'

import packageJson from '../../package.json'

import Main from './Main.astro'

export type Props = {
  data: NoteType['data']
  id: string
  slug: string
  rawBody?: string
}

const { data, id, slug, rawBody } = Astro.props

const githubLink =
  packageJson.repository.url + '/edit/main/src/content/notes/' + id

const dateObject = new Date(data.date)
const readingTime = getReadingTime(rawBody)
---

<Main
  title={data.title}
  fullTitle={data.title + META.ogTitle}
  description={data.description}
  date={dateObject.toISOString().split('T')[0]}
  type="article"
  url={'/notes/' + slug}
  image={data.image?.url ?? `/note-images/${id.replace(/\.[^/.]+$/, '')}.png`}>
  <article
    class:list={[
      'w-full max-w-none',
      'prose prose-neutral dark:prose-invert lg:prose-lg', // general
      'prose-pre:border-primary dark:prose-pre:border-primary-dark',
      'prose-pre:rounded-lg prose-pre:border-2',
      'prose-pre:shadow-xl prose-pre:shadow-gray-300/70 dark:prose-pre:shadow-2xl dark:prose-pre:shadow-black/80',
      'prose-blockquote:border-l-4 prose-blockquote:border-primary prose-blockquote:italic dark:prose-blockquote:border-primary-dark',
      'prose-blockquote:before:content-none prose-blockquote:after:content-none',
      'prose-figure:my-8',
      'prose-figcaption:relative prose-figcaption:z-10 prose-figcaption:mt-4 prose-figcaption:text-center prose-figcaption:text-sm prose-figcaption:text-gray-500 dark:prose-figcaption:text-gray-400',
      'prose-img:rounded-lg prose-img:shadow-xl prose-img:shadow-gray-300/70 prose-img:ring-1 prose-img:ring-gray-900/5 prose-img:transition-shadow dark:prose-img:shadow-2xl dark:prose-img:shadow-black/80 dark:prose-img:ring-1 dark:prose-img:ring-white/10',
      'prose-iframe:w-full prose-iframe:rounded-lg prose-iframe:shadow-xl prose-iframe:shadow-gray-300/70 prose-iframe:ring-1 prose-iframe:ring-gray-900/5 dark:prose-iframe:shadow-2xl dark:prose-iframe:shadow-black/80 dark:prose-iframe:ring-1 dark:prose-iframe:ring-white/10',
      'prose-headings:font-bold',
      'prose-p:text-gray-700 dark:prose-p:text-gray-200',
      'prose-headings:text-gray-700 dark:prose-headings:text-gray-200',
    ]}>
    <nav aria-label="Breadcrumb" class="not-prose mb-6">
      <Link
        href="/notes/"
        title="Back to all notes"
        analyticsClick="back-to-notes"
        class="dimmed inline-flex items-center gap-1.5 text-base hover:text-primary dark:hover:text-primary-dark">
        <Iconed>
          <ArrowLeft slot="icon" size={18} />
          <span>All notes</span>
        </Iconed>
      </Link>
    </nav>
    {
      data.image && (
        <Image
          src={data.image.url}
          alt={data.image.alt}
          width={data.image.width ?? 1600}
          height={data.image.height ?? 900}
          class="aspect-video w-full rounded-lg object-cover shadow-xl shadow-gray-300/70 ring-1 ring-gray-900/5 dark:shadow-2xl dark:shadow-black/80 dark:ring-1 dark:ring-white/10"
        />
      )
    }
    <header class="pb-0">
      <h1 class="mb-0 pb-2 lg:mb-0 lg:pb-2">{data.title}</h1>
      <p class="dimmed m-0 p-0 lg:m-0 lg:p-0">
        <time dateTime={dateObject.toISOString()}>
          {
            dateObject.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
            })
          }
        </time>
        {
          readingTime && (
            <span>
              <span class="mx-1.5">{SEPARATOR}</span>
              {readingTime}
            </span>
          )
        }
        {
          (data?.tags ?? []).map((tag: string) => (
            <span key={tag}>
              <span class="mx-1.5">{SEPARATOR}</span>#{tag}
            </span>
          ))
        }
      </p>
    </header>

    <slot />

    <Separator />
    <footer>
      <Link
        isExternal
        href={URLS[Social.Twitter] ?? ''}
        title="Discuss on Twitter"
        analyticsClick="discuss-on-twitter">
        Discuss on Twitter
      </Link>
      {SEPARATOR}
      <Link
        isExternal
        href={githubLink}
        title="Edit on GitHub"
        analyticsClick="edit-on-github">
        Edit on GitHub
      </Link>
    </footer>
  </article>
</Main>
