---
import Footer from '@components/Footer.astro'
import Header from '@components/Header.astro'
import Link from '@components/Link.astro'

import BaseLayout from './BaseLayout.astro'
---

<BaseLayout {...Astro.props}>
  <Link
    analyticsClick="skip-to-content"
    href="#start-of-content"
    title="Skip to content"
    class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:border focus:border-primary focus:bg-white focus:p-3 focus:shadow-lg dark:focus:border-primary-dark dark:focus:bg-stone-900">
    Skip to content
  </Link>
  <div class="flex min-h-screen flex-col items-center justify-center p-4 pt-0">
    <Header class="max-w-screen-md px-2 sm:px-6" />
    <main class="w-full max-w-screen-md flex-1 pt-6 sm:px-6">
      <slot />
    </main>
    <Footer class="max-w-screen-md px-2 sm:px-6" />
  </div>
</BaseLayout>
